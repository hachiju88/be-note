# Supabase 接続情報
# ローカル開発では `supabase start` の出力値、本番では Supabase プロジェクトの Settings > API の値を設定する。

# クライアント公開用（ブラウザから参照される）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# サーバー専用（API Routes / Server Actions のみ。絶対に公開しない）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
